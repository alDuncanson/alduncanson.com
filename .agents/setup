#!/usr/bin/env bash
# Prepare an Amp orb: realize the Nix development shell and load it into login shells.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_profile="$HOME/.nix-profile"

step() {
	local name="$1"
	shift
	echo "==> $name"
	local start=$SECONDS
	"$@"
	echo "<== $name ($((SECONDS - start))s)"
}

if ! command -v nix >/dev/null 2>&1; then
	# shellcheck disable=SC1091
	source "$nix_profile/etc/profile.d/nix.sh"
fi

# Fetch Caddy and the rest of the dev shell into the Nix store so the snapshot contains them.
realize_dev_shell() {
	nix print-dev-env "$repo_root" >/dev/null
}
step "Realize Nix development shell" realize_dev_shell

# Amp and supervised services run in non-interactive login shells. Load the flake's dev shell
# there, the same environment `nix develop` provides, without spawning a nested shell.
profile_marker="# alduncanson.com Nix development shell"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	echo "==> Add Nix development shell hook to ~/.bash_profile"
	cat >>"$HOME/.bash_profile" <<PROFILE

$profile_marker
if [[ -z "\${IN_NIX_SHELL:-}" && "\${PWD}" == "$repo_root" ]]; then
	eval "\$("$nix_profile/bin/nix" print-dev-env --option warn-dirty false "$repo_root")" >/dev/null
fi
PROFILE
fi
