#!/usr/bin/env bash
# Prepare an Amp orb: realize the Nix development shell and load it into login shells.
set -euo pipefail

if [[ "${AMP_ORB:-}" != 1 ]]; then
	echo "Not in an Amp orb; leaving this machine unchanged." >&2
	exit 0
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
	local name="$1"
	shift
	echo "==> $name"
	local start=$SECONDS
	"$@"
	echo "<== $name ($((SECONDS - start))s)"
}

if ! command -v nix >/dev/null 2>&1; then
	# shellcheck disable=SC1091
	source "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

# Fetch Caddy and the rest of the dev shell into the Nix store so the snapshot contains them.
realize_dev_shell() {
	nix print-dev-env "$repo_root" >/dev/null
}
step "Realize Nix development shell" realize_dev_shell

# Amp and supervised services run in non-interactive login shells. Source .agents/dev-shell there
# so shells started in the repository root get the flake's dev shell without a nested shell.
profile="$HOME/.bash_profile"
marker="# alduncanson.com Nix development shell"
hook="$(printf '%s\nif [[ -f %q ]]; then\n\tsource %q\nfi' "$marker" "$repo_root/.agents/dev-shell" "$repo_root/.agents/dev-shell")"
if [[ "$(sed -n "/^$marker\$/,/^fi\$/p" "$profile" 2>/dev/null)" != "$hook" ]]; then
	echo "==> Install Nix development shell hook in ~/.bash_profile"
	# Replace any earlier version of the hook, including one for another checkout path.
	if [[ -f "$profile" ]]; then
		sed -i "/^$marker\$/,/^fi\$/d" "$profile"
	fi
	printf '\n%s\n' "$hook" >>"$profile"
fi
